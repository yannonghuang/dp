# Copy to .env and fill in real values. .env is gitignored.

# ── Backend LLM: DashScope (Qwen) ─────────────────────────────────────────────
# Get a key from the Alibaba Cloud DashScope/Bailian console, or copy the
# workspace one from ../schub-openclaw/.env.dev.
DASHSCOPE_API_KEY=
# Default shared endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1
# Override for a dedicated/reserved-capacity MaaS deployment.
DASHSCOPE_BASE_URL=
ASSESSMENT_MODEL=qwen3.7-plus

# ── Fallback LLM: OpenAI (used only if DASHSCOPE_API_KEY is unset) ───────────
OPENAI_API_KEY=
